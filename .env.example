# ── BFF（服务端运行时变量，不是 VITE_*，不会内联进客户端产物）──
# 生产：docker 网络内的 Caddy sidecar；本地：compose override 发布出来的同一个容器。
BFF_UPSTREAM_HTTP=http://127.0.0.1:8787
BFF_UPSTREAM_WS=ws://127.0.0.1:8787
# 会话库路径。生产是 sessions 卷里的 /data/sessions.sqlite。
SESSION_DB_PATH=./sessions.sqlite
# cookie 的 Secure 属性。生产必须 true；本地 http 下必须 false，否则浏览器整条丢弃。
SESSION_COOKIE_SECURE=false

VITE_SENTRY_DSN=

# 留空或整行注释掉表示"使用 package.json 的版本号"（vite.config.ts 里
# env.VITE_APP_VERSION || pkg.version 会自动回退）。只有需要让显示版本号
# 与 package.json 不同步时才取消注释并显式赋值——常驻写死一个值会永久
# 冻结版本徽标和 Sentry release 标签，不会随发布自动更新。
# VITE_APP_VERSION=1.0.1

# cloudflared 隧道 token（真实值从 Cloudflare Zero Trust 控制台的隧道详情页获取）。
# 真实值只放本机未跟踪的 .env，绝不提交；docker-compose.yml 里只引用 ${CF_TUNNEL_TOKEN} 变量名。
CF_TUNNEL_TOKEN=changeme-cloudflare-tunnel-token
